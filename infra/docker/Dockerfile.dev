# syntax=docker/dockerfile:1
#
# Imagem de dev do monorepo (usada por `api` e `web` em docker-compose.dev.yml).
# node_modules fica assado nesta camada; em runtime o código-fonte é montado
# via bind mount (hot-reload) e volumes anônimos protegem os node_modules
# instalados aqui para não serem sobrescritos pelo bind mount do host.
FROM node:22-slim

# procps (ps): o `nest start --watch` usa `ps --ppid` pra achar e matar o
# processo filho ao reiniciar após uma recompilação — sem ele, o restart
# lança ENOENT não tratado e derruba o container inteiro (visto ao testar
# hot-reload: 1ª recompilação ok, morreu ao tentar reiniciar o processo).
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl ca-certificates procps && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY services/api/package.json ./services/api/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/types/package.json ./packages/types/package.json
COPY packages/config/package.json ./packages/config/package.json
# services/api tem "postinstall": "prisma generate" (garante o client
# sempre gerado — ver services/api/package.json). Sem o schema aqui, esse
# postinstall falha em build time com "schema.prisma: file not found",
# já que o resto do código só chega via bind mount em runtime.
COPY services/api/prisma ./services/api/prisma

RUN pnpm install --frozen-lockfile

CMD ["pnpm", "dev"]
