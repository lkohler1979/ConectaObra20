# Server blocks do Nginx pro ConectaObra 2.0 — dois domínios públicos:
#   - conectaon.unifyhub.com.br     -> apps/web (Next.js, porta 3399)
#   - apiconectaon.unifyhub.com.br  -> services/api (NestJS, porta 3355)
#
# Copiar pra /etc/nginx/sites-available/conectaobra e habilitar com um
# symlink em sites-enabled (ver DEPLOY.md §9). Diferente de uma versão
# anterior deste guia, a API agora é pública no próprio domínio — mas
# apps/web continua chamando a API só internamente via 127.0.0.1:3355
# (Route Handlers em apps/web/lib/api-client.ts), nunca pelo domínio
# público. O domínio público da API existe pra consumidores externos
# (apps mobile futuros, integrações, teste manual) — sem CORS habilitado
# hoje (services/api/src/main.ts não chama app.enableCors()), então
# chamadas via browser a partir de outro domínio (ex.: JS rodando em
# conectaon.unifyhub.com.br chamando apiconectaon.unifyhub.com.br) vão
# falhar por CORS até isso ser adicionado — não é necessário pro
# funcionamento do site em si, só pra integrações client-side diretas.
#
# Depois de habilitar este arquivo, rodar (ver DEPLOY.md §9):
#   sudo certbot --nginx -d conectaon.unifyhub.com.br -d apiconectaon.unifyhub.com.br
# — o certbot edita os dois server blocks abaixo automaticamente pra
# adicionar o bloco HTTPS (443) e o redirect HTTP->HTTPS em cada um.

server {
    listen 80;
    listen [::]:80;
    server_name conectaon.unifyhub.com.br;

    location / {
        proxy_pass http://127.0.0.1:3399;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name apiconectaon.unifyhub.com.br;

    location / {
        proxy_pass http://127.0.0.1:3355;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
