# Copiar para .env.local e ajustar conforme necessário.
# Server-only (nunca NEXT_PUBLIC_): o browser nunca chama services/api
# diretamente, só via Route Handlers deste app (ver lib/api-client.ts).
API_URL="http://localhost:3355"

# URL do apps/admin (app separado, porta 3096 em dev) — só usado pra renderizar
# o link discreto de acesso ao Admin no rodapé da home. Sem domínio de
# produção definido ainda (não faz parte do DEPLOY.md hoje) — ajustar quando
# apps/admin for implantado.
ADMIN_URL="http://localhost:3096"

# Opcionais — analytics de funil (E10-03). Sem NEXT_PUBLIC_POSTHOG_KEY,
# lib/posthog.ts nunca inicializa o client (no-op, ver PENDENCIAS.md).
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
