# ===== ConectaObra 2.0 — variáveis de ambiente (validadas com zod no boot) =====
DATABASE_URL=postgresql://conectaobra:conectaobra@localhost:5432/conectaobra
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key
S3_ENDPOINT=
S3_BUCKET=conectaobra-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
ANTHROPIC_API_KEY=            # IA Engenheiro Virtual
PSP_API_KEY=                  # [P-002] definir após escolha do PSP de escrow
PSP_WEBHOOK_SECRET=
ESIGN_API_KEY=                # [P-006] assinatura eletrônica
KYC_API_KEY=                  # [P-006] verificação de identidade
JWT_SECRET=change-me
SENTRY_DSN=                   # [P-011]
