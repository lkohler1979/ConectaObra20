# Copiar para .env e ajustar conforme necessário.
# Credenciais batem com infra/docker/docker-compose.local.yml (uso local apenas).
DATABASE_URL="postgresql://conectaobra:conectaobra@localhost:5432/conectaobra?schema=public"
REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_API_KEY="dev-master-key"

NODE_ENV=development
PORT=3355
LOG_LEVEL=debug

# Opcional em dev — sem DSN, o Sentry.init() vira no-op (ver P-011).
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"

# Gerar em dev com: openssl rand -base64 48
JWT_SECRET="dev-only-secret-troque-antes-de-qualquer-deploy-real-0123456789"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
MFA_CHALLENGE_TTL_SECONDS=300

# Opcionais — sem eles, POST /media/presigned-upload responde 503 (ver PENDENCIAS.md P-018).
# S3_BUCKET="conectaobra-media-dev"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT="http://localhost:9000" # só para MinIO/S3-compatível local

# Placeholder até E8-01 definir os planos de verdade (ver PENDENCIAS.md P-025).
FREE_PLAN_MONTHLY_PROPOSAL_LIMIT=5

# Placeholder dentro da faixa "3-8%" do backlog (E7-04) — checkout de compra
# usa PSP SIMULADO (sempre sucesso) até o PSP real ser escolhido (P-002).
# Basis points: 500 = 5%.
PROCUREMENT_COMMISSION_BPS=500

# Placeholder dentro da faixa "2-5%" do Hub Financeiro (01_PRD M4) — escrow
# usa PSP SIMULADO (depósito/liberação sempre sucesso) até o PSP real ser
# escolhido (P-002). Basis points: 300 = 3%.
ESCROW_COMMISSION_BPS=300

# Dias sem resposta do cliente até a etapa ENTREGUE ser aprovada
# automaticamente (E4-08), com avisos em D-3/D-1. Setar 0 em dev testa sem
# esperar dias de verdade (o job de auto-aprovação dispara quase na hora).
MILESTONE_AUTO_APROVACAO_DIAS=7

# Guard-rail de rate-limit por plano do chat de IA (E5-06) — mesmo padrão
# de FREE_PLAN_MONTHLY_PROPOSAL_LIMIT (P-025). Placeholder até E8-01.
AI_CHAT_FREE_PLAN_DAILY_LIMIT=10

# Placeholder dentro da faixa "15-25%" do catálogo de plantas (01_PRD M8,
# E9-05) — checkout usa PSP SIMULADO até o PSP real ser escolhido (P-002).
# Basis points: 2000 = 20%.
CATALOG_COMMISSION_BPS=2000
