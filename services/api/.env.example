# Copiar para .env e ajustar conforme necessário.
# Credenciais batem com infra/docker/docker-compose.local.yml (uso local apenas).
DATABASE_URL="postgresql://conectaobra:conectaobra@localhost:5432/conectaobra?schema=public"

NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Opcional em dev — sem DSN, o Sentry.init() vira no-op (ver P-011).
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"

# Gerar em dev com: openssl rand -base64 48
JWT_SECRET="dev-only-secret-troque-antes-de-qualquer-deploy-real-0123456789"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
